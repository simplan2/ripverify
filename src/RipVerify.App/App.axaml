<App
    x:Class="RipVerify.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:RipVerify.App.Converters"
    RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RipVerify/Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
      <converters:DatabaseStatusToBrushConverter x:Key="DatabaseStatusToBrushConverter" />
    </ResourceDictionary>
  </Application.Resources>
  
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://RipVerify/Styles/Styles.axaml" />
  </Application.Styles>

</App>
